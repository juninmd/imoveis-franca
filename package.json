{
  "name": "imoveis-baratos-franca",
  "version": "0.0.0",
  "description": "Minimalistic boilerplate to quick-start Node.js development in TypeScript.",
  "engines": {
    "node": ">= 20.9"
  },
  "dependencies": {
    "@juninmd/digest-kit": "^0.4.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/helmet": "^0.0.48",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "p-limit": "^7.3.3",
    "puppeteer": "^25.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qs": "^6.17.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/cheerio": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "~26.6.6",
    "@types/p-limit": "^2.2.0",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "~8.72",
    "@typescript-eslint/parser": "~8.72",
    "eslint": "~10.14",
    "eslint-config-prettier": "~10.1",
    "jest": "^30.5.2",
    "playwright": "^1.65.0",
    "rimraf": "~6.1",
    "ts-jest": "^29.4.15",
    "ts-node": "~10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "clean": "rimraf coverage build tmp",
    "build": "cd client && pnpm install --frozen-lockfile && pnpm run build && cd .. && tsc -p tsconfig.json",
    "test": "jest",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint . --ext .ts --ext .mts",
    "lint:fix": "eslint . --ext .ts --ext .mts --fix",
    "test:coverage": "jest --coverage"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "playwright"
    ],
    "overrides": {
      "follow-redirects@1.16.1": ">=1.16.2 <2.0.0",
      "undici@7.30.0": ">=7.30.1 <8.0.0"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
